# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real keys.

# --- Supabase (required) ----------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The "service_role" key from the same page. SECRET — server-only, used by
# Server Actions (app/admin/actions.ts, app/submit/actions.ts) and the seed
# script to bypass Row Level Security. Never prefix this with NEXT_PUBLIC_,
# and never reference it from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login (required to use /admin) -----------------------------------
# Interim password gate for /admin until real accounts (Clerk) are wired up.
# Pick something long and unique; anyone with it can publish/approve listings.
ADMIN_PASSWORD=

# --- Site URL (recommended) --------------------------------------------------
# Used for canonical URLs, sitemap.xml, and Open Graph tags. Set this to your
# real domain in production (e.g. in Vercel's Environment Variables).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Not used yet — see README "Connecting the real backend" ---------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
